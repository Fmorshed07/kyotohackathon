# Firebase (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hackathon-tokyo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional server-side alias for the Firebase Web API key. Used only to read
# explicitly public project records for share-card metadata.
FIREBASE_WEB_API_KEY=

# Admin portal
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=
ADMIN_PASSWORD=

# Nodemailer / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM_NAME=Cognisor AI
# Where to notify when a participant completes onboarding details
PARTICIPANT_NOTIFY_EMAIL=creativecognisor@gmail.com
# Public site URL used in email CTAs + footer links
EMAIL_APP_URL=https://your-deployment.vercel.app
# Optional: absolute logo URL for HTML previews (CID used in real sends)
# EMAIL_LOGO_URL=https://your-deployment.vercel.app/app.png
FIREBASE_PROJECT_ID=hackathon-tokyo

# Server only: used by /api/hackathon-ai. Never prefix this key with VITE_.
OPENAI_API_KEY=
# Optional default model for the admin AI event builder (admins can also pick in UI).
# Latest options include gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna, gpt-5.5, gpt-5.4-mini, gpt-4.1-mini
OPENAI_HACKATHON_MODEL=gpt-5.6-luna
