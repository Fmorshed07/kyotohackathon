rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUnderLimit() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile-avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isImageUnderLimit();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /profile-media/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isImageUnderLimit();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /event-media/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isImageUnderLimit();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
