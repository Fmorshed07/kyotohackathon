rules_version = '2';

// Community data model (additive; existing portal collections are unchanged):
// community_channels/{general|teams|judges}/messages/{20-character auto-ID}:
//   user_id string <=128, author_name string 1..80, author_role enum,
//   body nonblank string <=2000, created_at server timestamp. Immutable;
//   only its author may delete. No account emails/private profiles are copied.
// community_chat_limits/{uid}: channel_id enum, message_id auto-ID,
//   last_sent_at server timestamp. Atomic with one new message, 3s cooldown.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function currentUserRole() {
      return userDocExists() ? get(userDocPath()).data.get("role", null) : null;
    }

    // Built-in portal admin account (username/password login — hidden Firebase email).
    function isPortalAdminAccount() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches('portal-admin\\..*@firebase\\.app');
    }

    function isAdmin() {
      let role = currentUserRole();
      return isSignedIn() && (
        isPortalAdminAccount()
        || role == "admin"
        || role == "admins"
      );
    }

    function isStaff() {
      let role = currentUserRole();
      return isSignedIn() && (
        role == "judge"
        || role == "judges"
        || role == "mentor"
        || role == "mentors"
      );
    }

    function isApprovedStaff() {
      return isStaff() && get(userDocPath()).data.judgeApprovalStatus == "approved";
    }

    function isHost() {
      let role = currentUserRole();
      return isSignedIn() && (
        role == "host" || role == "hosts"
      );
    }

    function isApprovedHost() {
      return isHost()
        && get(userDocPath()).data.hostApprovalStatus == "approved";
    }

    function hasPendingAdminGrant() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admin_grants/$(request.auth.token.email.lower()));
    }

    function openJudgeInvitePath(token) {
      return /databases/$(database)/documents/portal_invites/$(token);
    }

    function hasOpenJudgeInvite(token) {
      return token is string
        && token.size() > 8
        && exists(openJudgeInvitePath(token))
        && get(openJudgeInvitePath(token)).data.status == "open"
        && get(openJudgeInvitePath(token)).data.type == "judge";
    }

    function canCreateJudgeViaInvite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "judge"
        && request.resource.data.judgeApprovalStatus == "approved"
        && request.resource.data.keys().hasAll(["invite_token"])
        && hasOpenJudgeInvite(request.resource.data.invite_token);
    }

    // New or pending judges redeeming a portal invite get approved + hackathon access.
    function canRedeemJudgeInvite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "judge"
        && request.resource.data.judgeApprovalStatus == "approved"
        && request.resource.data.keys().hasAll(["invite_token"])
        && hasOpenJudgeInvite(request.resource.data.invite_token)
        && (
          !("role" in resource.data)
          || resource.data.role == null
          || resource.data.role == ""
          || resource.data.role == "judge"
          || resource.data.role == "mentor"
        );
    }

    function canCreateOwnPortalAccount(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role == "participant"
          || (
            (request.resource.data.role == "judge" || request.resource.data.role == "mentor")
            && request.resource.data.judgeApprovalStatus == "pending"
          )
          || canCreateJudgeViaInvite(userId)
          || (
            request.resource.data.role == "host"
            && request.resource.data.hostApprovalStatus == "pending"
          )
        );
    }

    function canUpdateOwnProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName", "avatarUrl", "coverUrl", "galleryUrls", "headline", "bio", "publicRole",
          "experienceLevel", "organization", "location", "timezone", "languages", "lookingFor",
          "githubUsername", "githubProfileUrl", "linkedinUrl", "portfolioUrl", "xUrl",
          "discordHandle", "skills", "interests", "profileUpdatedAt", "onboardingCompletedAt",
          "hackathon_id", "hackathon_ids"
        ]);
    }

    // Participants never need admin approval. Allow self-serve claim when:
    // - account has no role yet, or
    // - staff signup is still pending and the user switches to participant.
    function canClaimParticipantRole(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "participant"
        && (
          !("role" in resource.data)
          || resource.data.role == null
          || resource.data.role == ""
          || (
            (resource.data.role == "judge" || resource.data.role == "mentor")
            && resource.data.judgeApprovalStatus == "pending"
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "role", "hackathon_id", "hackathon_ids", "judgeApprovalStatus"
        ]);
    }

    // Auth users with no portal role yet may request judge/mentor/host access (pending approval).
    // Covers setDoc(merge) when a stub user doc already exists (update, not create).
    function canRequestStaffOrHostRole(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && (
          !("role" in resource.data)
          || resource.data.role == null
          || resource.data.role == ""
        )
        && (
          (
            (request.resource.data.role == "judge" || request.resource.data.role == "mentor")
            && request.resource.data.judgeApprovalStatus == "pending"
          )
          || (
            request.resource.data.role == "host"
            && request.resource.data.hostApprovalStatus == "pending"
          )
        );
    }

    function ownsHostEvent(eventId) {
      return isSignedIn()
        && eventId is string && eventId.size() > 0
        && exists(/databases/$(database)/documents/host_events/$(eventId))
        && get(/databases/$(database)/documents/host_events/$(eventId)).data.get("owner_id", "") == request.auth.uid;
    }

    function ownsHackathon(hackathonId) {
      return hackathonId is string
        && hackathonId.size() > 0
        && exists(/databases/$(database)/documents/hackathons/$(hackathonId))
        && (
          get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.get("createdBy", "") == request.auth.uid
          || (
            get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.get("hostEventId", "") is string
            && ownsHostEvent(
              get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.get("hostEventId", "")
            )
          )
        );
    }

    function canManageHackathon(hackathonId) {
      return isAdmin() || (isApprovedHost() && ownsHackathon(hackathonId));
    }

    function hackathonPath(hackathonId) {
      return /databases/$(database)/documents/hackathons/$(hackathonId);
    }

    function validSubmissionModeValue(value) {
      return value == "open" || value == "paused" || value == "closed";
    }

    function validSubmissionModeOnWrite() {
      return !("submissionMode" in request.resource.data)
        || validSubmissionModeValue(request.resource.data.submissionMode);
    }

    // The same gate protects creates and updates. Explicit open can reopen a past
    // event; otherwise respect unpublished/past listings and imported deadlines.
    function eventAllowsParticipantProjectWrites(data) {
      let mode = data.get("submissionMode", "");
      let endAtMs = data.get("endAtMs", null);
      return data.get("published", true) != false && (
        mode == "open" || (
          mode != "paused" && mode != "closed"
          && data.get("status", "upcoming") != "past"
          && !(data.get("sourceLifecycleAutomatic", false) == true
            && endAtMs is number && request.time.toMillis() >= endAtMs)
        )
      );
    }

    // Absent legacy listings remain writable. Judge/organiser marks use separate rules.
    function hackathonAllowsParticipantProjectWrites(hackathonId) {
      return !(hackathonId is string && hackathonId.size() > 0)
        || !exists(hackathonPath(hackathonId))
        || eventAllowsParticipantProjectWrites(get(hackathonPath(hackathonId)).data);
    }

    function requestHackathonId() {
      return request.resource.data.get("hackathon_id", null) is string
        ? request.resource.data.hackathon_id
        : "";
    }

    function existingHackathonId() {
      return resource.data.get("hackathon_id", null) is string ? resource.data.hackathon_id : "";
    }

    // Approved hosts may approve pending judges/mentors for events they own.
    function canHostApproveJudge() {
      return isApprovedHost()
        && (resource.data.role == "judge" || resource.data.role == "mentor")
        && resource.data.judgeApprovalStatus == "pending"
        && request.resource.data.role == resource.data.role
        && request.resource.data.judgeApprovalStatus == "approved"
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["judgeApprovalStatus", "hackathon_id", "hackathon_ids"])
        && request.resource.data.hackathon_id is string
        && ownsHackathon(request.resource.data.hackathon_id)
        && request.resource.data.hackathon_ids is list
        && request.resource.data.hackathon_ids.hasAll([request.resource.data.hackathon_id])
        && (
          !("hackathon_ids" in resource.data)
          || !(resource.data.hackathon_ids is list)
          || request.resource.data.hackathon_ids.hasAll(resource.data.hackathon_ids)
        )
        && (
          !("hackathon_id" in resource.data)
          || resource.data.hackathon_id == null
          || resource.data.hackathon_id == ""
          || request.resource.data.hackathon_ids.hasAll([resource.data.hackathon_id])
        );
    }

    // Approved hosts may reject pending judges/mentors (convert to participant).
    function canHostRejectJudge() {
      return isApprovedHost()
        && (resource.data.role == "judge" || resource.data.role == "mentor")
        && resource.data.judgeApprovalStatus == "pending"
        && request.resource.data.role == "participant"
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["role", "judgeApprovalStatus"]);
    }

    match /users/{userId} {
      allow create: if (isPortalAdminAccount() && request.auth.uid == userId)
        || (hasPendingAdminGrant() && request.auth.uid == userId)
        || canCreateOwnPortalAccount(userId);
      // Approved hosts need participant/judge emails for submissions & mark check.
      // Signed-in teammates can read participant profiles for the team roster.
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isApprovedHost()
        || isApprovedStaff()
        || resource.data.role == "participant"
        || resource.data.role == "participants"
      );
      allow update: if isAdmin()
        || (hasPendingAdminGrant() && request.auth.uid == userId)
        || canUpdateOwnProfile(userId)
        || canClaimParticipantRole(userId)
        || canRequestStaffOrHostRole(userId)
        || canRedeemJudgeInvite(userId)
        || canHostApproveJudge()
        || canHostRejectJudge();
      allow delete: if isAdmin();
    }

    match /host_events/{eventId} {
      allow create: if isAdmin()
        || (isApprovedHost() && request.resource.data.owner_id == request.auth.uid);
      allow read: if isAdmin() || (isApprovedHost() && resource.data.owner_id == request.auth.uid);
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == request.auth.uid
      );
      allow delete: if isAdmin() || (isApprovedHost() && resource.data.owner_id == request.auth.uid);
    }

    match /host_tickets/{ticketId} {
      allow create: if isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.host_id == request.auth.uid
          && ownsHostEvent(request.resource.data.event_id)
        );
      allow read: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
        && request.resource.data.host_id == resource.data.host_id
        && request.resource.data.event_id == resource.data.event_id
      );
      allow delete: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
    }

    match /host_judges/{judgeId} {
      allow create: if isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.host_id == request.auth.uid
          && ownsHostEvent(request.resource.data.event_id)
        );
      allow read: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
        && request.resource.data.host_id == resource.data.host_id
        && request.resource.data.event_id == resource.data.event_id
      );
      allow delete: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
    }

    match /submissions/{submissionId} {
      // Participant payloads contain project/team fields only. All preliminary,
      // legacy and final scoring fields belong to judges or organisers.
      function isSubmissionOwner() {
        return isSignedIn() && resource.data.get("user_id", "") == request.auth.uid;
      }

      function isSubmissionTeammate() {
        return isSignedIn()
          && (
            request.auth.uid in resource.data.get("member_user_ids", [])
            || exists(/databases/$(database)/documents/team_memberships/$(submissionId + '_' + request.auth.uid))
          );
      }

      function submissionCoreUnchanged() {
        let beforeEvent = resource.data.get("hackathon_id", null);
        let afterEvent = request.resource.data.get("hackathon_id", null);
        return request.resource.data.user_id == resource.data.user_id
          && (
            afterEvent == beforeEvent
            // The portal maps old event-less records to Impact Tokyo. Its save
            // flow backfills this id; that is not a transfer to another event.
            || (beforeEvent in [null, ""] && afterEvent == "impact-tokyo")
          );
      }

      function validTeamLeader() {
        return !("team_leader_id" in request.resource.data)
          || request.resource.data.team_leader_id == resource.data.user_id
          || (
            resource.data.get("member_user_ids", []) is list
            && request.resource.data.team_leader_id in resource.data.get("member_user_ids", [])
          )
          || request.resource.data.team_leader_id == request.auth.uid;
      }

      function judgingFields() {
        return [
          "judge_id",
          "judge_score",
          "judge_notes",
          "judge_criteria_scores",
          "judge_scores",
          "judge_notes_by_judge",
          "judge_criteria_scores_by_judge",
          "final_shortlisted",
          "final_shortlisted_at",
          "final_judge_scores",
          "final_judge_notes_by_judge",
          "final_judge_criteria_scores_by_judge"
        ];
      }

      // Dotted SDK updates must preserve every other judge's entry. Check both
      // additions and removals, including replacing an entire map.
      function validOwnJudgeMapChange(field, valueType) {
        let before = resource.data.get(field, {});
        let after = request.resource.data.get(field, {});
        let value = after is map ? after.get(request.auth.uid, null) : null;
        return after is map
          && after.diff(before is map ? before : {}).affectedKeys().hasOnly([request.auth.uid])
          && (
            (valueType == "score" && value is number && value >= 0 && value <= 10000)
            || (valueType == "notes" && value is string && value.size() <= 10000)
            || (valueType == "criteria" && value is map && value.size() > 0 && value.size() <= 50)
          );
      }

      function validJudgeRoundUpdate(prefix) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let scores = prefix + "_scores";
        let notes = prefix + "_notes_by_judge";
        let criteria = prefix + "_criteria_scores_by_judge";
        return changed.hasOnly([scores, notes, criteria])
          && (!changed.hasAny([scores]) || validOwnJudgeMapChange(scores, "score"))
          && (!changed.hasAny([notes]) || validOwnJudgeMapChange(notes, "notes"))
          && (!changed.hasAny([criteria]) || validOwnJudgeMapChange(criteria, "criteria"));
      }

      function canUpdateOwnJudgeMarks() {
        return validJudgeRoundUpdate("judge")
          || (resource.data.get("final_shortlisted", false) == true && validJudgeRoundUpdate("final_judge"));
      }

      function teammateEditableKeys() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "track_id",
          "title",
          "short_description",
          "project_url",
          "submission_pdf_url",
          "demo_video_url",
          "public_preview_consent",
          "cover_url",
          "gallery_urls",
          "team_name",
          "member_names",
          "member_name_list",
          "team_members",
          "member_user_ids",
          "team_leader_id",
          "role",
          "created_at",
          "updated_at",
          "join_invite_token"
        ]);
      }

      function isInviteJoinUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["member_names", "member_name_list", "team_members", "member_user_ids", "join_invite_token"])
          && request.resource.data.keys().hasAll(["join_invite_token"])
          && request.resource.data.join_invite_token is string
          && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token))
          && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.status == "open"
          && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.submission_id == submissionId
          && request.resource.data.user_id == resource.data.user_id;
      }

      // Private by default. Public gallery/boards use public_projects only after explicit opt-in.
      allow read: if isAdmin()
        || isApprovedStaff()
        || isApprovedHost()
        || isSubmissionOwner()
        || isSubmissionTeammate();
      allow create: if isSignedIn() && (
        isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.keys().hasAll(["user_id", "hackathon_id"])
          && ownsHackathon(request.resource.data.hackathon_id)
        )
        || (
          request.auth.uid == request.resource.data.user_id
          && !request.resource.data.keys().hasAny(judgingFields())
          && hackathonAllowsParticipantProjectWrites(requestHackathonId())
        )
      );
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          isApprovedHost()
          && resource.data.hackathon_id is string
          && ownsHackathon(resource.data.hackathon_id)
        )
        || (
          isApprovedStaff() ? canUpdateOwnJudgeMarks() : (
            isInviteJoinUpdate()
            || (
              isSubmissionOwner()
              && submissionCoreUnchanged()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(judgingFields())
              && hackathonAllowsParticipantProjectWrites(existingHackathonId())
            )
            || (
              isSubmissionTeammate()
              && submissionCoreUnchanged()
              && teammateEditableKeys()
              && validTeamLeader()
              && hackathonAllowsParticipantProjectWrites(existingHackathonId())
            )
          )
        )
      );
      allow delete: if isAdmin()
        || (
          isApprovedHost()
          && resource.data.hackathon_id is string
          && ownsHackathon(resource.data.hackathon_id)
        );
    }

    // Cross-event community: all registered members, independent of event access.
    function isCommunityChannel(channelId) {
      return channelId in ["general", "teams", "judges"];
    }

    function isCommunityMember() {
      return userDocExists()
        && request.auth.token.get("firebase", {}).get("sign_in_provider", "") != "anonymous"
        && currentUserRole() in ["participant", "participants", "judge", "judges", "mentor", "mentors", "host", "hosts", "admin", "admins"];
    }

    // Approval gates badges, not networking access. Badges are never authority.
    function communityDisplayRole() {
      let data = get(userDocPath()).data;
      let role = data.get("role", "");
      return role in ["participant", "participants"] ? "participant"
        : role in ["admin", "admins"] ? "admin"
        : role in ["judge", "judges"] && data.get("judgeApprovalStatus", "") == "approved" ? "judge"
        : role in ["mentor", "mentors"] && data.get("judgeApprovalStatus", "") == "approved" ? "mentor"
        : role in ["host", "hosts"] && data.get("hostApprovalStatus", "") == "approved" ? "host"
        : "member";
    }

    function communityLimitPath() {
      return /databases/$(database)/documents/community_chat_limits/$(request.auth.uid);
    }

    function communityCooldownPassed() {
      return !exists(communityLimitPath())
        || request.time >= get(communityLimitPath()).data.last_sent_at + duration.value(3, 's');
    }

    function isValidCommunityMessage(data) {
      let fields = ["user_id", "author_name", "author_role", "body", "created_at"];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.user_id is string && data.user_id.size() > 0 && data.user_id.size() <= 128
        && data.author_name is string && data.author_name.size() > 0 && data.author_name.size() <= 80
        && data.author_name.matches('(?s).*[^\\s].*')
        && data.author_role in ["participant", "judge", "mentor", "host", "admin", "member"]
        && data.body is string && data.body.size() > 0 && data.body.size() <= 2000
        && data.body.matches('(?s).*[^\\s].*')
        && data.created_at is timestamp;
    }

    match /community_channels/{channelId}/messages/{messageId} {
      allow get: if isCommunityMember() && isCommunityChannel(channelId);
      allow list: if isCommunityMember() && isCommunityChannel(channelId)
        && request.query.limit != null && request.query.limit <= 100;
      allow create: if isCommunityMember() && isCommunityChannel(channelId)
        && messageId.matches('^[a-zA-Z0-9]{20}$')
        && isValidCommunityMessage(request.resource.data)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.author_role == communityDisplayRole()
        && request.resource.data.created_at == request.time
        && communityCooldownPassed()
        && getAfter(communityLimitPath()).data.last_sent_at == request.time
        && getAfter(communityLimitPath()).data.channel_id == channelId
        && getAfter(communityLimitPath()).data.message_id == messageId;
      // Messages cannot be rewritten, re-owned, backdated, or schema-polluted.
      allow update: if false;
      allow delete: if isCommunityMember() && isCommunityChannel(channelId)
        && resource.data.user_id == request.auth.uid;
    }

    function isValidCommunityLimit(data) {
      let fields = ["channel_id", "message_id", "last_sent_at"];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.channel_id is string && isCommunityChannel(data.channel_id)
        && data.message_id is string && data.message_id.matches('^[a-zA-Z0-9]{20}$')
        && data.last_sent_at is timestamp && data.last_sent_at == request.time;
    }

    function hasNewCommunityMessage(data) {
      let path = /databases/$(database)/documents/community_channels/$(data.channel_id)/messages/$(data.message_id);
      return !exists(path)
        && getAfter(path).data.user_id == request.auth.uid
        && getAfter(path).data.created_at == request.time;
    }

    match /community_chat_limits/{userId} {
      allow get: if isCommunityMember() && userId == request.auth.uid;
      allow create, update: if isCommunityMember() && userId == request.auth.uid
        && isValidCommunityLimit(request.resource.data)
        && communityCooldownPassed()
        && hasNewCommunityMessage(request.resource.data);
      allow list, delete: if false;
    }

    // Looking-for-teammates board: signed-in participants can browse and post.
    match /teammate_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.author_email is string
        && request.resource.data.looking_for is string
        && request.resource.data.hackathon_id is string;
      allow update, delete: if isSignedIn()
        && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Tokenized team invite links (document id == token).
    match /team_invites/{token} {
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || resource.data.owner_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.submission_id is string
        && request.resource.data.type == "team"
        && (
          request.resource.data.owner_id == request.auth.uid
          || (
            exists(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id))
            && get(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id)).data.user_id
              == request.resource.data.owner_id
            && get(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id)).data.member_user_ids is list
            && request.auth.uid in get(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id)).data.member_user_ids
          )
        );
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.owner_id == request.auth.uid
        || (
          resource.data.status == "open"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["use_count"])
          && request.resource.data.use_count == resource.data.use_count + 1
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    // Linked teammates who joined via invite.
    match /team_memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.invite_token is string
        && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_token))
        && get(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_token)).data.status == "open"
        && get(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_token)).data.submission_id
          == request.resource.data.submission_id;
      allow delete: if isSignedIn() && (
        isAdmin()
        || resource.data.user_id == request.auth.uid
        || resource.data.owner_id == request.auth.uid
      );
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.user_id == request.auth.uid)
        || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    // Judge portal invite links (document id == token). Anyone with the link can resolve it.
    match /portal_invites/{token} {
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || isApprovedHost());
      allow create: if isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.created_by == request.auth.uid
          && request.resource.data.type == "judge"
        );
      allow update: if isSignedIn() && (
        isAdmin()
        || (isApprovedHost() && resource.data.created_by == request.auth.uid)
        || (
          resource.data.status == "open"
          && resource.data.type == "judge"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["use_count", "used_by"])
        )
      );
      allow delete: if isAdmin()
        || (isApprovedHost() && resource.data.created_by == request.auth.uid);
    }

    // A minimal public copy is created when a team, host, or admin opts the project into the gallery.
    // This deliberately avoids publishing private submissions, judging notes, or score data.
    match /public_projects/{projectId} {
      function isPublicProjectInviteJoin() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["member_names", "member_name_list", "team_members", "member_user_ids", "team_leader_id", "join_invite_token"])
          && request.resource.data.keys().hasAll(["join_invite_token"])
          && request.resource.data.join_invite_token is string
          && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token))
          && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.status == "open"
          && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.submission_id == projectId;
      }

      allow read: if true;
      allow create: if isAdmin()
        || (
          request.resource.data.hackathon_id is string
          && canManageHackathon(request.resource.data.hackathon_id)
        )
        || (
          isSignedIn()
          && request.resource.data.public_preview_consent == true
          && hackathonAllowsParticipantProjectWrites(requestHackathonId())
          && (
            request.resource.data.owner_id == request.auth.uid
            || (
              request.resource.data.owner_id is string
              && request.resource.data.member_user_ids is list
              && request.auth.uid in request.resource.data.member_user_ids
              && exists(/databases/$(database)/documents/submissions/$(projectId))
              && get(/databases/$(database)/documents/submissions/$(projectId)).data.user_id
                == request.resource.data.owner_id
            )
          )
        );
      allow update: if isAdmin()
        || (
          resource.data.hackathon_id is string
          && canManageHackathon(resource.data.hackathon_id)
        )
        || isPublicProjectInviteJoin()
        || (
          isSignedIn()
          && request.resource.data.owner_id == resource.data.owner_id
          && request.resource.data.public_preview_consent == true
          && hackathonAllowsParticipantProjectWrites(existingHackathonId())
          && (
            request.resource.data.owner_id == request.auth.uid
            || (
              resource.data.member_user_ids is list
              && request.auth.uid in resource.data.member_user_ids
            )
          )
        );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.owner_id == request.auth.uid)
        || (
          resource.data.hackathon_id is string
          && canManageHackathon(resource.data.hackathon_id)
        );
    }

    // Community star ratings for public projects. Public pages show stars only — never judge scores.
    // Visitors may star once per browser voter id — no account required.
    match /project_stars/{starId} {
      function isWholeStar(value) {
        return value is number
          && value >= 1
          && value <= 5
          && value == int(value);
      }

      function validVoterId(id) {
        return id is string
          && id.size() >= 16
          && id.size() <= 64
          && id.matches('^[A-Za-z0-9_-]+$');
      }

      function publicStarCreate() {
        return request.resource.data.project_id is string
          && request.resource.data.project_id.size() > 0
          && validVoterId(request.resource.data.user_id)
          && isWholeStar(request.resource.data.stars)
          && starId == request.resource.data.project_id + '_' + request.resource.data.user_id
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 6
          && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && request.resource.data.keys().hasOnly([
            "project_id", "user_id", "stars", "email", "created_at", "updated_at"
          ]);
      }

      allow get: if true;
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if publicStarCreate();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /project_star_stats/{projectId} {
      function validVoterId(id) {
        return id is string
          && id.size() >= 16
          && id.size() <= 64
          && id.matches('^[A-Za-z0-9_-]+$');
      }

      function voterRatingPath() {
        return /databases/$(database)/documents/project_stars/$(
          projectId + '_' + request.resource.data.last_voter_id
        );
      }

      function statsKeysOk() {
        return request.resource.data.keys().hasOnly(["star_sum", "star_count", "updated_at", "last_voter_id"])
          && request.resource.data.star_sum is number
          && request.resource.data.star_count is number
          && request.resource.data.star_sum >= 0
          && request.resource.data.star_count >= 0
          && request.resource.data.star_sum <= request.resource.data.star_count * 5
          && validVoterId(request.resource.data.last_voter_id);
      }

      function newPublicRatingDelta() {
        return !exists(voterRatingPath())
          && existsAfter(voterRatingPath())
          && getAfter(voterRatingPath()).data.user_id == request.resource.data.last_voter_id
          && request.resource.data.star_count == resource.data.star_count + 1
          && request.resource.data.star_sum
            == resource.data.star_sum + getAfter(voterRatingPath()).data.stars;
      }

      allow read: if true;
      allow create: if statsKeysOk()
        && existsAfter(voterRatingPath())
        && getAfter(voterRatingPath()).data.user_id == request.resource.data.last_voter_id
        && request.resource.data.star_count == 1
        && request.resource.data.star_sum == getAfter(voterRatingPath()).data.stars;
      allow update: if statsKeysOk()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["star_sum", "star_count", "updated_at", "last_voter_id"])
        && newPublicRatingDelta();
      allow delete: if isAdmin();
    }

    // Distinct browser share intent for public projects. The aggregate keeps the gallery social proof
    // useful without storing a visitor's personal information or exposing individual share records.
    match /project_shares/{shareId} {
      function validSharerId(id) {
        return id is string
          && id.size() >= 16
          && id.size() <= 64
          && id.matches('^[A-Za-z0-9_-]+$');
      }

      function publicShareCreate() {
        return request.resource.data.project_id is string
          && request.resource.data.project_id.size() > 0
          && validSharerId(request.resource.data.user_id)
          && shareId == request.resource.data.project_id + '_' + request.resource.data.user_id
          && request.resource.data.created_at is string
          && request.resource.data.keys().hasOnly(["project_id", "user_id", "created_at"])
          && exists(/databases/$(database)/documents/public_projects/$(request.resource.data.project_id));
      }

      allow get: if true;
      allow list: if false;
      allow create: if publicShareCreate();
      allow update, delete: if isAdmin();
    }

    match /project_share_stats/{projectId} {
      function validSharerId(id) {
        return id is string
          && id.size() >= 16
          && id.size() <= 64
          && id.matches('^[A-Za-z0-9_-]+$');
      }

      function sharePath() {
        return /databases/$(database)/documents/project_shares/$(
          projectId + '_' + request.resource.data.last_sharer_id
        );
      }

      function shareStatsKeysOk() {
        return request.resource.data.keys().hasOnly(["share_count", "updated_at", "last_sharer_id"])
          && request.resource.data.share_count is number
          && request.resource.data.share_count >= 0
          && request.resource.data.updated_at is string
          && validSharerId(request.resource.data.last_sharer_id);
      }

      function newPublicShare() {
        return !exists(sharePath())
          && existsAfter(sharePath())
          && getAfter(sharePath()).data.project_id == projectId
          && getAfter(sharePath()).data.user_id == request.resource.data.last_sharer_id
          && request.resource.data.share_count == resource.data.share_count + 1;
      }

      allow read: if true;
      allow create: if shareStatsKeysOk()
        && existsAfter(sharePath())
        && getAfter(sharePath()).data.project_id == projectId
        && getAfter(sharePath()).data.user_id == request.resource.data.last_sharer_id
        && request.resource.data.share_count == 1;
      allow update: if shareStatsKeysOk()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["share_count", "updated_at", "last_sharer_id"])
        && newPublicShare();
      allow delete: if isAdmin();
    }

    // Email-only waitlist for upcoming hackathons. No account required.
    match /hackathon_subscribers/{subscriberId} {
      function validSubscribeEmail(value) {
        return value is string
          && value.size() >= 6
          && value.size() <= 254
          && value == subscriberId
          && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      }

      allow create: if validSubscribeEmail(request.resource.data.email)
        && request.resource.data.keys().hasOnly(["email", "created_at", "source"])
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 80
        && request.resource.data.created_at is string;
      allow read, update, delete: if isAdmin();
    }

    // Anonymous, first-party page-view events for the admin audience dashboard.
    // No IP address, email, query string, or authenticated user id is stored.
    match /site_page_views/{viewId} {
      function validAnalyticsId(value) {
        return value is string
          && value.size() >= 16
          && value.size() <= 64
          && value.matches('^[A-Za-z0-9_-]+$');
      }

      allow create: if request.resource.data.keys().hasOnly([
          "visitor_id",
          "session_id",
          "path",
          "page_group",
          "source",
          "created_at"
        ])
        && validAnalyticsId(request.resource.data.visitor_id)
        && validAnalyticsId(request.resource.data.session_id)
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 200
        && request.resource.data.path.matches('^/.*')
        && request.resource.data.page_group is string
        && request.resource.data.page_group.size() > 0
        && request.resource.data.page_group.size() <= 40
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 40
        && request.resource.data.created_at is string;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /hackathon_criteria/{hackathonId} {
      allow read: if true;
      allow create, update: if canManageHackathon(hackathonId);
      allow delete: if isAdmin();
    }

    // Public pages load published events. Approved hosts can publish/update their own listings,
    // including pausing or closing submissions on events they own.
    match /hackathons/{hackathonId} {
      function preservesListingCreator() {
        return request.resource.data.get("createdBy", "") == resource.data.get("createdBy", "")
          || (
            !("createdBy" in resource.data)
            && request.resource.data.createdBy == request.auth.uid
            && ownsHostEvent(resource.data.get("hostEventId", ""))
          );
      }

      allow get: if resource.data.published == true
        || canManageHackathon(hackathonId);
      allow list: if resource.data.published == true || isAdmin();
      allow create: if validSubmissionModeOnWrite() && (
        isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.hostEventId is string
          && request.resource.data.hostEventId.size() > 0
          && ownsHostEvent(request.resource.data.hostEventId)
        )
      );
      allow update: if validSubmissionModeOnWrite() && (
        isAdmin()
        || (
          isApprovedHost()
          && ownsHackathon(hackathonId)
          && preservesListingCreator()
          && (
            !("hostEventId" in resource.data)
            || request.resource.data.hostEventId == resource.data.hostEventId
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /hackathon_ops/{hackathonId} {
      // Admins + staff (read). Approved hosts can run screening/ops on events they own.
      allow read: if isSignedIn() && (
        isAdmin()
        || isApprovedStaff()
        || (isApprovedHost() && ownsHackathon(hackathonId))
      );
      allow write: if canManageHackathon(hackathonId);
    }

    match /admin_grants/{grantEmail} {
      allow get: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.token.email != null
          && grantEmail == request.auth.token.email.lower()
        )
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /judge_rankings/{rankingId} {
      function isOwnRankingDoc() {
        return isApprovedStaff()
          && rankingId.matches('^' + request.auth.uid + '_.*');
      }

      allow get: if isSignedIn() && (isAdmin() || isOwnRankingDoc() || isApprovedHost());
      allow list: if isAdmin() || isApprovedHost();
      allow create: if isApprovedStaff()
        && request.resource.data.judge_id == request.auth.uid
        && rankingId == request.resource.data.judge_id + '_' + request.resource.data.hackathon_id;
      allow update: if isApprovedStaff()
        && resource.data.judge_id == request.auth.uid
        && request.resource.data.judge_id == request.auth.uid;
      allow delete: if isAdmin()
        || (
          isApprovedHost()
          && resource.data.hackathon_id is string
          && ownsHackathon(resource.data.hackathon_id)
        );
    }
  }
}
