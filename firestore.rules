rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function currentUserRole() {
      return userDocExists() ? get(userDocPath()).data.role : null;
    }

    // Built-in portal admin account (username/password login — hidden Firebase email).
    function isPortalAdminAccount() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches('portal-admin\\..*@firebase\\.app');
    }

    function isAdmin() {
      return isSignedIn() && (
        isPortalAdminAccount()
        || currentUserRole() == "admin"
        || currentUserRole() == "admins"
      );
    }

    function isStaff() {
      return isSignedIn() && (
        currentUserRole() == "judge"
        || currentUserRole() == "judges"
        || currentUserRole() == "mentor"
        || currentUserRole() == "mentors"
      );
    }

    function isApprovedStaff() {
      return isStaff() && get(userDocPath()).data.judgeApprovalStatus == "approved";
    }

    function isHost() {
      return isSignedIn() && (
        currentUserRole() == "host" || currentUserRole() == "hosts"
      );
    }

    function isApprovedHost() {
      return isHost()
        && get(userDocPath()).data.hostApprovalStatus == "approved";
    }

    function hasPendingAdminGrant() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admin_grants/$(request.auth.token.email.lower()));
    }

    function openJudgeInvitePath(token) {
      return /databases/$(database)/documents/portal_invites/$(token);
    }

    function hasOpenJudgeInvite(token) {
      return token is string
        && token.size() > 8
        && exists(openJudgeInvitePath(token))
        && get(openJudgeInvitePath(token)).data.status == "open"
        && get(openJudgeInvitePath(token)).data.type == "judge";
    }

    function canCreateJudgeViaInvite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "judge"
        && request.resource.data.judgeApprovalStatus == "approved"
        && request.resource.data.keys().hasAll(["invite_token"])
        && hasOpenJudgeInvite(request.resource.data.invite_token);
    }

    // New or pending judges redeeming a portal invite get approved + hackathon access.
    function canRedeemJudgeInvite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "judge"
        && request.resource.data.judgeApprovalStatus == "approved"
        && request.resource.data.keys().hasAll(["invite_token"])
        && hasOpenJudgeInvite(request.resource.data.invite_token)
        && (
          !("role" in resource.data)
          || resource.data.role == null
          || resource.data.role == ""
          || resource.data.role == "judge"
          || resource.data.role == "mentor"
        );
    }

    function canCreateOwnPortalAccount(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role == "participant"
          || (
            (request.resource.data.role == "judge" || request.resource.data.role == "mentor")
            && request.resource.data.judgeApprovalStatus == "pending"
          )
          || canCreateJudgeViaInvite(userId)
          || (
            request.resource.data.role == "host"
            && request.resource.data.hostApprovalStatus == "pending"
          )
        );
    }

    function canUpdateOwnProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName", "avatarUrl", "coverUrl", "galleryUrls", "headline", "bio", "publicRole",
          "experienceLevel", "organization", "location", "timezone", "languages", "lookingFor",
          "githubUsername", "githubProfileUrl", "linkedinUrl", "portfolioUrl", "xUrl",
          "discordHandle", "skills", "interests", "profileUpdatedAt", "onboardingCompletedAt",
          "hackathon_id", "hackathon_ids"
        ]);
    }

    // Participants never need admin approval. Allow self-serve claim when:
    // - account has no role yet, or
    // - staff signup is still pending and the user switches to participant.
    function canClaimParticipantRole(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "participant"
        && (
          !("role" in resource.data)
          || resource.data.role == null
          || resource.data.role == ""
          || (
            (resource.data.role == "judge" || resource.data.role == "mentor")
            && resource.data.judgeApprovalStatus == "pending"
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "role", "hackathon_id", "hackathon_ids", "judgeApprovalStatus"
        ]);
    }

    // Auth users with no portal role yet may request judge/mentor/host access (pending approval).
    // Covers setDoc(merge) when a stub user doc already exists (update, not create).
    function canRequestStaffOrHostRole(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && (
          !("role" in resource.data)
          || resource.data.role == null
          || resource.data.role == ""
        )
        && (
          (
            (request.resource.data.role == "judge" || request.resource.data.role == "mentor")
            && request.resource.data.judgeApprovalStatus == "pending"
          )
          || (
            request.resource.data.role == "host"
            && request.resource.data.hostApprovalStatus == "pending"
          )
        );
    }

    function ownsHostEvent(eventId) {
      return exists(/databases/$(database)/documents/host_events/$(eventId))
        && get(/databases/$(database)/documents/host_events/$(eventId)).data.owner_id == request.auth.uid;
    }

    function ownsHackathon(hackathonId) {
      return hackathonId is string
        && hackathonId.size() > 0
        && exists(/databases/$(database)/documents/hackathons/$(hackathonId))
        && (
          get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.createdBy == request.auth.uid
          || (
            get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.hostEventId is string
            && ownsHostEvent(
              get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.hostEventId
            )
          )
        );
    }

    // Approved hosts may approve pending judges/mentors for events they own.
    function canHostApproveJudge() {
      return isApprovedHost()
        && (resource.data.role == "judge" || resource.data.role == "mentor")
        && resource.data.judgeApprovalStatus == "pending"
        && request.resource.data.role == resource.data.role
        && request.resource.data.judgeApprovalStatus == "approved"
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["judgeApprovalStatus", "hackathon_id", "hackathon_ids"])
        && request.resource.data.hackathon_id is string
        && ownsHackathon(request.resource.data.hackathon_id)
        && request.resource.data.hackathon_ids is list
        && request.resource.data.hackathon_ids.hasAll([request.resource.data.hackathon_id])
        && (
          !("hackathon_ids" in resource.data)
          || !(resource.data.hackathon_ids is list)
          || request.resource.data.hackathon_ids.hasAll(resource.data.hackathon_ids)
        )
        && (
          !("hackathon_id" in resource.data)
          || resource.data.hackathon_id == null
          || resource.data.hackathon_id == ""
          || request.resource.data.hackathon_ids.hasAll([resource.data.hackathon_id])
        );
    }

    // Approved hosts may reject pending judges/mentors (convert to participant).
    function canHostRejectJudge() {
      return isApprovedHost()
        && (resource.data.role == "judge" || resource.data.role == "mentor")
        && resource.data.judgeApprovalStatus == "pending"
        && request.resource.data.role == "participant"
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["role", "judgeApprovalStatus"]);
    }

    match /users/{userId} {
      allow create: if (isPortalAdminAccount() && request.auth.uid == userId)
        || (hasPendingAdminGrant() && request.auth.uid == userId)
        || canCreateOwnPortalAccount(userId);
      // Approved hosts need participant/judge emails for submissions & mark check.
      // Signed-in teammates can read participant profiles for the team roster.
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isApprovedHost()
        || isApprovedStaff()
        || resource.data.role == "participant"
        || resource.data.role == "participants"
      );
      allow update: if isAdmin()
        || (hasPendingAdminGrant() && request.auth.uid == userId)
        || canUpdateOwnProfile(userId)
        || canClaimParticipantRole(userId)
        || canRequestStaffOrHostRole(userId)
        || canRedeemJudgeInvite(userId)
        || canHostApproveJudge()
        || canHostRejectJudge();
      allow delete: if isAdmin();
    }

    match /host_events/{eventId} {
      allow create: if isAdmin()
        || (isApprovedHost() && request.resource.data.owner_id == request.auth.uid);
      allow read: if isAdmin() || (isApprovedHost() && resource.data.owner_id == request.auth.uid);
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == request.auth.uid
      );
      allow delete: if isAdmin() || (isApprovedHost() && resource.data.owner_id == request.auth.uid);
    }

    match /host_tickets/{ticketId} {
      allow create: if isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.host_id == request.auth.uid
          && ownsHostEvent(request.resource.data.event_id)
        );
      allow read: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
        && request.resource.data.host_id == resource.data.host_id
        && request.resource.data.event_id == resource.data.event_id
      );
      allow delete: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
    }

    match /host_judges/{judgeId} {
      allow create: if isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.host_id == request.auth.uid
          && ownsHostEvent(request.resource.data.event_id)
        );
      allow read: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
        && request.resource.data.host_id == resource.data.host_id
        && request.resource.data.event_id == resource.data.event_id
      );
      allow delete: if isAdmin() || (
        isApprovedHost()
        && resource.data.host_id == request.auth.uid
      );
    }

    match /submissions/{submissionId} {
      function isSubmissionOwner() {
        return isSignedIn() && resource.data.user_id == request.auth.uid;
      }

      function isSubmissionTeammate() {
        return isSignedIn()
          && (
            (
              resource.data.member_user_ids is list
              && request.auth.uid in resource.data.member_user_ids
            )
            || exists(/databases/$(database)/documents/team_memberships/$(submissionId + '_' + request.auth.uid))
          );
      }

      function submissionCoreUnchanged() {
        return request.resource.data.user_id == resource.data.user_id
          && (
            !("hackathon_id" in resource.data)
            || request.resource.data.hackathon_id == resource.data.hackathon_id
          );
      }

      function validTeamLeader() {
        return !("team_leader_id" in request.resource.data)
          || request.resource.data.team_leader_id == resource.data.user_id
          || (
            resource.data.member_user_ids is list
            && request.resource.data.team_leader_id in resource.data.member_user_ids
          )
          || request.resource.data.team_leader_id == request.auth.uid;
      }

      function teammateEditableKeys() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "short_description",
          "project_url",
          "submission_pdf_url",
          "demo_video_url",
          "public_preview_consent",
          "cover_url",
          "gallery_urls",
          "team_name",
          "member_names",
          "member_name_list",
          "team_members",
          "member_user_ids",
          "team_leader_id",
          "role",
          "created_at",
          "updated_at",
          "join_invite_token"
        ]);
      }

      function isInviteJoinUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["member_names", "member_name_list", "team_members", "member_user_ids", "join_invite_token"])
          && request.resource.data.keys().hasAll(["join_invite_token"])
          && request.resource.data.join_invite_token is string
          && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token))
          && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.status == "open"
          && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.submission_id == submissionId
          && request.resource.data.user_id == resource.data.user_id;
      }

      // Private by default. Public gallery/boards use public_projects only after explicit opt-in.
      allow read: if isAdmin()
        || isApprovedStaff()
        || isApprovedHost()
        || isSubmissionOwner()
        || isSubmissionTeammate();
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.user_id
        || isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.keys().hasAll(["user_id", "hackathon_id"])
          && ownsHackathon(request.resource.data.hackathon_id)
        )
      );
      allow update: if isSignedIn() && (
        isSubmissionOwner()
        || isApprovedStaff()
        || isAdmin()
        || (
          isApprovedHost()
          && resource.data.hackathon_id is string
          && ownsHackathon(resource.data.hackathon_id)
        )
        || isInviteJoinUpdate()
        || (
          isSubmissionTeammate()
          && submissionCoreUnchanged()
          && teammateEditableKeys()
          && validTeamLeader()
        )
      );
      allow delete: if isAdmin()
        || (
          isApprovedHost()
          && resource.data.hackathon_id is string
          && ownsHackathon(resource.data.hackathon_id)
        );
    }

    // Looking-for-teammates board: signed-in participants can browse and post.
    match /teammate_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.author_email is string
        && request.resource.data.looking_for is string
        && request.resource.data.hackathon_id is string;
      allow update, delete: if isSignedIn()
        && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Tokenized team invite links (document id == token).
    match /team_invites/{token} {
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || resource.data.owner_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.submission_id is string
        && request.resource.data.type == "team"
        && (
          request.resource.data.owner_id == request.auth.uid
          || (
            exists(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id))
            && get(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id)).data.user_id
              == request.resource.data.owner_id
            && get(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id)).data.member_user_ids is list
            && request.auth.uid in get(/databases/$(database)/documents/submissions/$(request.resource.data.submission_id)).data.member_user_ids
          )
        );
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.owner_id == request.auth.uid
        || (
          resource.data.status == "open"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["use_count"])
          && request.resource.data.use_count == resource.data.use_count + 1
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    // Linked teammates who joined via invite.
    match /team_memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.invite_token is string
        && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_token))
        && get(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_token)).data.status == "open"
        && get(/databases/$(database)/documents/team_invites/$(request.resource.data.invite_token)).data.submission_id
          == request.resource.data.submission_id;
      allow delete: if isSignedIn() && (
        isAdmin()
        || resource.data.user_id == request.auth.uid
        || resource.data.owner_id == request.auth.uid
      );
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.user_id == request.auth.uid)
        || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    // Judge portal invite links (document id == token). Anyone with the link can resolve it.
    match /portal_invites/{token} {
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || isApprovedHost());
      allow create: if isAdmin()
        || (
          isApprovedHost()
          && request.resource.data.created_by == request.auth.uid
          && request.resource.data.type == "judge"
        );
      allow update: if isSignedIn() && (
        isAdmin()
        || (isApprovedHost() && resource.data.created_by == request.auth.uid)
        || (
          resource.data.status == "open"
          && resource.data.type == "judge"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["use_count", "used_by"])
        )
      );
      allow delete: if isAdmin()
        || (isApprovedHost() && resource.data.created_by == request.auth.uid);
    }

    // A minimal public copy is created only by a participant who opts their project into the gallery.
    // This deliberately avoids publishing private submissions, judging notes, or score data.
    match /public_projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.public_preview_consent == true
        && (
          request.resource.data.owner_id == request.auth.uid
          || (
            request.resource.data.owner_id is string
            && request.resource.data.member_user_ids is list
            && request.auth.uid in request.resource.data.member_user_ids
            && exists(/databases/$(database)/documents/submissions/$(projectId))
            && get(/databases/$(database)/documents/submissions/$(projectId)).data.user_id
              == request.resource.data.owner_id
          )
        ));
      allow update: if isAdmin()
        || (isSignedIn()
          && request.resource.data.owner_id == resource.data.owner_id
          && request.resource.data.public_preview_consent == true
          && (
            request.resource.data.owner_id == request.auth.uid
            || (
              resource.data.member_user_ids is list
              && request.auth.uid in resource.data.member_user_ids
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["member_names", "member_name_list", "team_members", "member_user_ids", "team_leader_id", "join_invite_token"])
              && request.resource.data.keys().hasAll(["join_invite_token"])
              && request.resource.data.join_invite_token is string
              && exists(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token))
              && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.status == "open"
              && get(/databases/$(database)/documents/team_invites/$(request.resource.data.join_invite_token)).data.submission_id == projectId
            )
          )
        );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    match /hackathon_criteria/{hackathonId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isApprovedHost()
        && exists(/databases/$(database)/documents/hackathons/$(hackathonId))
        && get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.createdBy == request.auth.uid
      );
    }

    // Public pages load published events. Approved hosts can publish/update their own listings.
    match /hackathons/{hackathonId} {
      allow get: if resource.data.published == true
        || isAdmin()
        || (isApprovedHost() && resource.data.createdBy == request.auth.uid);
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() || (
        isApprovedHost()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.hostEventId is string
        && request.resource.data.hostEventId.size() > 0
        && ownsHostEvent(request.resource.data.hostEventId)
      );
      allow update: if isAdmin() || (
        isApprovedHost()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          !("hostEventId" in resource.data)
          || request.resource.data.hostEventId == resource.data.hostEventId
        )
      );
      allow delete: if isAdmin();
    }

    match /hackathon_ops/{hackathonId} {
      // Admins + staff (read). Approved hosts can run screening/ops on events they own.
      allow read: if isSignedIn() && (
        isAdmin()
        || isApprovedStaff()
        || (isApprovedHost() && ownsHackathon(hackathonId))
      );
      allow write: if isAdmin()
        || (isApprovedHost() && ownsHackathon(hackathonId));
    }

    match /admin_grants/{grantEmail} {
      allow get: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.token.email != null
          && grantEmail == request.auth.token.email.lower()
        )
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /judge_rankings/{rankingId} {
      function isOwnRankingDoc() {
        return isApprovedStaff()
          && rankingId.matches('^' + request.auth.uid + '_.*');
      }

      allow get: if isSignedIn() && (isAdmin() || isOwnRankingDoc() || isApprovedHost());
      allow list: if isAdmin() || isApprovedHost();
      allow create: if isApprovedStaff()
        && request.resource.data.judge_id == request.auth.uid
        && rankingId == request.resource.data.judge_id + '_' + request.resource.data.hackathon_id;
      allow update: if isApprovedStaff()
        && resource.data.judge_id == request.auth.uid
        && request.resource.data.judge_id == request.auth.uid;
      allow delete: if isAdmin()
        || (
          isApprovedHost()
          && resource.data.hackathon_id is string
          && ownsHackathon(resource.data.hackathon_id)
        );
    }
  }
}
