rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function currentUserRole() {
      return userDocExists() ? get(userDocPath()).data.role : null;
    }

    // Built-in portal admin account (username/password login — hidden Firebase email).
    function isPortalAdminAccount() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches('portal-admin\\..*@firebase\\.app');
    }

    function isAdmin() {
      return isSignedIn() && (
        isPortalAdminAccount()
        || currentUserRole() == "admin"
        || currentUserRole() == "admins"
      );
    }

    function isStaff() {
      return isSignedIn() && (
        currentUserRole() == "judge"
        || currentUserRole() == "judges"
        || currentUserRole() == "mentor"
        || currentUserRole() == "mentors"
      );
    }

    function isApprovedStaff() {
      return isStaff() && (
        !userDocExists()
        || get(userDocPath()).data.judgeApprovalStatus != "pending"
      );
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == request.resource.data.user_id || isAdmin());
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.user_id
        || isApprovedStaff()
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /hackathon_criteria/{hackathonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_grants/{grantEmail} {
      allow get: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.token.email != null
          && grantEmail == request.auth.token.email.lower()
        )
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /judge_rankings/{rankingId} {
      function isOwnRankingDoc() {
        return isApprovedStaff()
          && rankingId.matches('^' + request.auth.uid + '_.*');
      }

      allow get: if isSignedIn() && (isAdmin() || isOwnRankingDoc());
      allow list: if isAdmin();
      allow create: if isApprovedStaff()
        && request.resource.data.judge_id == request.auth.uid
        && rankingId == request.resource.data.judge_id + '_' + request.resource.data.hackathon_id;
      allow update: if isApprovedStaff()
        && resource.data.judge_id == request.auth.uid
        && request.resource.data.judge_id == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
